# Scooby-Doo: Refrightened - only sources, project files and scripts are tracked.
# Game data (the user's own disc) and everything built or downloaded stays out.
/Disc/
/game/
/toolchain/
/autotest/
/build-logs/
/dist/
/_runtime_spm_backup/
/Play/*
!/Play/portable.txt
!/Play/Run with log.cmd

# wiicompiled build output, downloaded dependencies and translator binaries
/wiicompiled/generated/
/wiicompiled/native-build/
/wiicompiled/build/
/wiicompiled/Dependencies/
/wiicompiled/translator/**/bin/
/wiicompiled/translator/**/obj/
/wiicompiled/Launcher/**/bin/
/wiicompiled/Launcher/**/obj/
/launcher/bin/
/launcher/obj/
/launcher/publish/

# written by the build from the disc (build_logic_overlay.py) / build output
/wiicompiled/projects/scooby/MAP_all.txt
/wiicompiled/projects/scooby/MAP_logic.txt
__pycache__/
*.pyc
wiicompiled/buildtools/artifacts/
*.log
*.log.out
texture_pack/

# notes for development sessions, not part of the project
AGENTS.md

# local disc images (never commit)
*.iso
*.ciso
*.wbfs
*.gcm
*.rvz

# issue #2 investigation leftovers (use tools/manual-session.ps1 locally; do not commit)
tools/_retired_auto/
tools/_score_verify_shots.py
tools/manual-session.ps1
