+// FOGCOV PROBE: guest backtrace (LR, then the saved LR of each stack frame) for aurora's raw-draw probe
+extern "C" int (*g_no100fGuestBacktrace)(char* out, int size);
+static int No100fGuestBacktrace(char* out, int size) {
+    const CpuContext* x = TryGetCpuContext();
+    if (!x) return std::snprintf(out, size, "?");
+    int n = std::snprintf(out, size, "lr %08X", uint32_t(x->lr));
+    uint32_t sp = x->gpr[1];
+    for (int i = 0; i < 10 && n < size - 12; ++i) {
+        uint32_t next = 0, lr = 0;
+        if (!Memory::TryRead32(sp, next) || !next || !Memory::TryRead32(next + 4, lr)) break;
+        n += std::snprintf(out + n, size - n, " %08X", lr);
+        sp = next;
+    }
+    return n;
+}
+static const bool s_no100fGuestBacktraceSet = [] { g_no100fGuestBacktrace = &No100fGuestBacktrace; return true; }();
