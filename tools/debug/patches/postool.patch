+//   trace ADDR N         for N frames: list length and first 4 particles of the list whose head is [ADDR]
+//                        (particle: +0 next, +8 life, +0x10 pos, +0x1C size) to postool/trace.txt
+static uint32_t s_traceHeadPtr = 0, s_traceLeft = 0;
+static void No100fPosToolTrace()
+{
+    static uint32_t frame = 0;
+    ++frame;
+    if (!s_traceLeft) return;
+    --s_traceLeft;
+    std::ofstream out("postool/trace.txt", std::ios::app);
+    uint32_t p = 0, n = 0;
+    Memory::TryRead32(s_traceHeadPtr, p);
+    std::string head;
+    static std::vector<uint32_t> prev;
+    std::vector<uint32_t> cur;
+    for (uint32_t q = p; q >= 0x80000000u && n < 2000; ++n) {
+        cur.push_back(q);
+        if (n < 4) {
+            char b[96];
+            std::snprintf(b, sizeof b, " %08X(%.2f %.2f %.2f L%.2f)", q, Memory::ReadFloat32(q + 0x10), Memory::ReadFloat32(q + 0x14),
+                          Memory::ReadFloat32(q + 0x18), Memory::ReadFloat32(q + 8));
+            head += b;
+        }
+        if (!Memory::TryRead32(q, q)) break;
+    }
+    if (cur == prev) return;  // the main loop polls the retrace count more than once per frame
+    std::string gone;
+    for (size_t i = 0; i < prev.size(); ++i)
+        if (std::find(cur.begin(), cur.end(), prev[i]) == cur.end()) {
+            char b[96];
+            std::snprintf(b, sizeof b, " %08X@%zu(%.2f %.2f %.2f L%.2f)", prev[i], i, Memory::ReadFloat32(prev[i] + 0x10),
+                          Memory::ReadFloat32(prev[i] + 0x14), Memory::ReadFloat32(prev[i] + 0x18), Memory::ReadFloat32(prev[i] + 8));
+            gone += b;
+        }
+    prev = cur;
+    out << "t" << frame << " n" << n << head << " | gone" << gone << "\n";
+}
+
+//   births SECONDS       particle births per owner emitter asset (pool 2000 x 0x50 at 0x80210858: +8 life, +0x3C owner)
+//                        for SECONDS of wall time to postool/births.txt; "p1" = asset also emitted via the per-frame
+//                        update 0x800C4AAC (set by no100f_particles.cpp)
+std::unordered_set<uint32_t> g_no100fPath1Assets;
+static void No100fPosToolBirths(double seconds)
+{
+    struct Slot { float life = 0; uint32_t owner = 0; };
+    static std::vector<Slot> prev;
+    static std::unordered_map<uint32_t, uint64_t> births;
+    static std::chrono::steady_clock::time_point until{}, start{};
+    static uint64_t frames = 0;
+    const auto now = std::chrono::steady_clock::now();
+    if (seconds > 0) {
+        prev.clear(); births.clear(); frames = 0;
+        start = now;
+        until = now + std::chrono::duration_cast<std::chrono::steady_clock::duration>(std::chrono::duration<double>(seconds));
+    }
+    if (until == std::chrono::steady_clock::time_point{}) return;
+    std::vector<Slot> cur(2000);
+    for (uint32_t i = 0; i < 2000; ++i) {
+        const uint32_t p = 0x80210858u + i * 0x50u;
+        cur[i].life = Memory::ReadFloat32(p + 8);
+        cur[i].owner = Memory::Read32(p + 0x3C);
+    }
+    // count frames: the main loop polls the retrace count several times per frame, the pool changes once per frame
+    if (!prev.empty()) {
+        bool changed = false;
+        for (uint32_t i = 0; i < 2000; ++i) {
+            if (cur[i].life != prev[i].life || cur[i].owner != prev[i].owner) changed = true;
+            if (cur[i].owner && (cur[i].owner != prev[i].owner || cur[i].life > prev[i].life + 1e-4f)) ++births[cur[i].owner];
+        }
+        if (changed) ++frames;
+    }
+    prev = std::move(cur);
+    if (now < until) return;
+    until = {};
+    const double secs = std::chrono::duration<double>(now - start).count();
+    std::ofstream out("postool/births.txt", std::ios::app);
+    char b[160];
+    std::snprintf(b, sizeof b, "window %.2fs pool-changing frames %llu (%.1f/s)\n", secs, (unsigned long long)frames, frames / secs);
+    out << b;
+    for (const auto& [owner, n] : births) {
+        uint32_t id = 0;
+        Memory::TryRead32(owner, id);
+        std::snprintf(b, sizeof b, "owner %08X id %08X births %llu (%.1f/s)%s\n", owner, id, (unsigned long long)n, n / secs,
+                      g_no100fPath1Assets.count(owner) ? " p1" : "");
+        out << b;
+    }
+}
