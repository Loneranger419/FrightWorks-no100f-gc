+static void No100fPosToolPoll()
+{
+    No100fPosToolTrace();
+    No100fPosToolBirths(0);
+    static bool f9Down = false;
+    const bool f9 = (GetAsyncKeyState(0x78) & 0x8000) != 0;
+    if (f9 && !f9Down) No100fPosToolSaveSpot();
+    f9Down = f9;
+    static uint32_t tick = 0;
+    if (++tick % 20 != 0) return;
+    std::ifstream in("postool.txt");
+    if (!in) return;
+    std::vector<std::string> lines;
+    for (std::string l; std::getline(in, l);) lines.push_back(l);
+    in.close();
+    std::remove("postool.txt");
+    std::filesystem::create_directories("postool");
+    for (const std::string& l : lines) {
+        char cmd[16] = {}, name[128] = {};
+        if (std::sscanf(l.c_str(), "%15s %127s", cmd, name) < 1) continue;
+        if (std::string(cmd) == "dump") {
+            std::vector<uint8_t> buf(Memory::kMem1Size);
+            for (size_t i = 0; i < buf.size(); i += 4) {
+                uint32_t v = 0;
+                Memory::TryRead32(Memory::kMem1CachedBase + static_cast<uint32_t>(i), v);
+                buf[i] = v >> 24; buf[i + 1] = v >> 16; buf[i + 2] = v >> 8; buf[i + 3] = v;
+            }
+            std::ofstream(std::string("postool/") + name + ".bin", std::ios::binary)
+                .write(reinterpret_cast<const char*>(buf.data()), buf.size());
+        } else if (std::string(cmd) == "peek") {
+            uint32_t addr = 0, n = 16;
+            std::sscanf(l.c_str(), "%*s %x %u", &addr, &n);
+            std::ofstream out("postool/peek.txt", std::ios::app);
+            for (uint32_t i = 0; i < n; ++i) {
+                uint32_t v = 0;
+                Memory::TryRead32(addr + i * 4, v);
+                float f; std::memcpy(&f, &v, 4);
+                char b[64]; std::snprintf(b, sizeof b, "%08X %08X %g\n", addr + i * 4, v, f);
+                out << b;
+            }
+        } else if (std::string(cmd) == "births") {
+            double s = 10;
+            std::sscanf(l.c_str(), "%*s %lf", &s);
+            No100fPosToolBirths(s);
+        } else if (std::string(cmd) == "trace") {
+            std::sscanf(l.c_str(), "%*s %x %u", &s_traceHeadPtr, &s_traceLeft);
+        } else if (std::string(cmd) == "poke") {
+            std::istringstream ss(l);
+            std::string c, a, w;
+            ss >> c >> a;
+            uint32_t addr = static_cast<uint32_t>(std::stoul(a, nullptr, 16));
+            while (ss >> w) { Memory::TryWrite32(addr, static_cast<uint32_t>(std::stoul(w, nullptr, 16))); addr += 4; }
+        }
+    }
+    std::ofstream("postool/done.txt") << lines.size() << "\n";
+}
