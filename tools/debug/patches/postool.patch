+// DEBUG postool: every 20 main-loop frames, run the commands in postool.txt (cwd = Play) and delete it.
+//   dump NAME            MEM1 big-endian to postool/NAME.bin
+//   peek ADDR [N]        N (default 16) words from ADDR to postool/peek.txt
+//   poke ADDR HEX...     write words (floats as hex) starting at ADDR
+//   F9 (global hotkey)   append Scooby's spot to postool/spots.txt and beep
+// Scooby's model matrix (xMat4x3: right, up, at, pos) is at [0x802453C8].
+extern "C" __declspec(dllimport) short __stdcall GetAsyncKeyState(int key);
+extern "C" __declspec(dllimport) int __stdcall MessageBeep(unsigned type);
+static void No100fPosToolSaveSpot()
+{
+    uint32_t mat = 0;
+    if (!Memory::TryRead32(0x802453C8u, mat) || mat < 0x80000000u) return;
+    float v[16];
+    for (int i = 0; i < 16; ++i) v[i] = Memory::ReadFloat32(mat + i * 4);
+    static int n = 0;
+    std::filesystem::create_directories("postool");
+    char b[160];
+    std::snprintf(b, sizeof b, "spot%d pos %.3f %.3f %.3f yaw %.4f\n", ++n, v[12], v[13], v[14],
+                  std::atan2(v[8], v[10]));
+    std::ofstream("postool/spots.txt", std::ios::app) << b;
+    MessageBeep(0);
+}
