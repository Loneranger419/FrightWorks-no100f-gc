+// --- Curtain pixel-ownership instrumentation (env-gated) ---
+static int gpu_owner_mode() {
+  static const int mode = [] {
+    const char* e = std::getenv("NO100F_GPU_OWNER");
+    return e ? std::atoi(e) : 0;
+  }();
+  return mode;
+}
+static FILE* gpu_owner_file() {
+  static FILE* f = []() -> FILE* {
+    if (!gpu_owner_mode()) return nullptr;
+    const char* path = std::getenv("NO100F_GPU_OWNER_FILE");
+    if (!path || !*path) path = "autotest/manual/curtain-owner.jsonl";
+    FILE* out = std::fopen(path, "ab");
+    if (!out) {
+      Log.warn("NO100F_GPU_OWNER: failed to open {}", path);
+      return nullptr;
+    }
+    const char* backend = "unknown";
+    switch (webgpu::g_backendType) {
+    case wgpu::BackendType::D3D11:
+      backend = "D3D11";
+      break;
+    case wgpu::BackendType::D3D12:
+      backend = "D3D12";
+      break;
+    case wgpu::BackendType::Vulkan:
+      backend = "Vulkan";
+      break;
+    case wgpu::BackendType::Metal:
+      backend = "Metal";
+      break;
+    case wgpu::BackendType::OpenGL:
+      backend = "OpenGL";
+      break;
+    case wgpu::BackendType::OpenGLES:
+      backend = "OpenGLES";
+      break;
+    default:
+      break;
+    }
+    std::fprintf(out, "{\"type\":\"backend\",\"backend\":\"%s\",\"backendType\":%d}\n", backend,
+                 (int)webgpu::g_backendType);
+    std::fflush(out);
+    Log.warn("NO100F_GPU_OWNER: logging to {} backend={}", path, backend);
+    return out;
+  }();
+  return f;
+}
+static uint32_t g_gpuOwnerEventInFrame = 0;
+static uint32_t g_gpuOwnerSkipA = UINT32_MAX;
+static uint32_t g_gpuOwnerSkipB = UINT32_MAX;
+// Extra inclusive ranges from comma lists, e.g. "177,259" or "255-256,261".
+static std::vector<std::pair<uint32_t, uint32_t>> g_gpuOwnerSkipRanges;
+static uint32_t g_gpuOwnerSkipParsedFrame = UINT32_MAX;
+static std::vector<uint32_t> g_gpuOwnerSkipSizes;
+// Pairs of (primitive, fifoVertexCount), e.g. "144:720,152:959" in curtain-skip-sig.txt
+static std::vector<std::pair<uint32_t, uint32_t>> g_gpuOwnerSkipSigs;
+// Triples (primitive, fifoVertexCount, posSize). n==0 wildcards vertex count.
+// e.g. "144:0:12648,152:398:6540" — stable when per-frame event ordinals drift.
+struct GpuOwnerSkipTriple {
+  uint32_t prim = 0;
+  uint32_t n = 0;
+  uint32_t size = 0;
+};
+static std::vector<GpuOwnerSkipTriple> g_gpuOwnerSkipTriples;
+static thread_local GpuOwnerDrawMeta g_pendingOwnerMeta{};
+static thread_local bool g_hasPendingOwnerMeta = false;
+static thread_local bool g_lastPushWasSkip = false;
+
+static bool read_skip_control_line(const char* filePath, char* buf, size_t bufSize) {
+  if (!filePath || !*filePath || !buf || bufSize < 2) return false;
+#if defined(_WIN32)
+  // Share with writers (PowerShell Set-Content); fopen("rb") exclusive-locks on Windows.
+  FILE* sf = _fsopen(filePath, "r", _SH_DENYNO);
+#else
+  FILE* sf = std::fopen(filePath, "rb");
+#endif
+  if (!sf) return false;
+  const bool ok = std::fgets(buf, static_cast<int>(bufSize), sf) != nullptr;
+  std::fclose(sf);
+  if (!ok) return false;
+  for (char* p = buf; *p; ++p) {
+    if (*p == '\r' || *p == '\n') {
+      *p = 0;
+      break;
+    }
+  }
+  return buf[0] != 0;
+}
+
+static void parse_gpu_owner_skip() {
+  // Reload at most once per frame so we do not fight the control-file writer every draw.
+  if (g_gpuOwnerSkipParsedFrame == g_frameIndex) return;
+  g_gpuOwnerSkipParsedFrame = g_frameIndex;
+  g_gpuOwnerSkipA = UINT32_MAX;
+  g_gpuOwnerSkipB = UINT32_MAX;
+  g_gpuOwnerSkipRanges.clear();
+  g_gpuOwnerSkipSizes.clear();
+  g_gpuOwnerSkipSigs.clear();
+  g_gpuOwnerSkipTriples.clear();
+  auto tryParseEvents = [&](const char* s) {
+    if (!s || !*s) return false;
+    // "a-b" or "a,b,c-d,e" (singles and inclusive ranges).
+    bool any = false;
+    size_t at = 0;
+    const std::string list(s);
+    while (at < list.size()) {
+      const size_t comma = list.find(',', at);
+      const auto part = list.substr(at, comma == std::string::npos ? list.size() - at : comma - at);
+      unsigned a = 0, b = 0;
+      if (std::sscanf(part.c_str(), "%u-%u", &a, &b) == 2) {
+        if (!any && g_gpuOwnerSkipA == UINT32_MAX) {
+          g_gpuOwnerSkipA = a;
+          g_gpuOwnerSkipB = b;
+        } else {
+          g_gpuOwnerSkipRanges.emplace_back(a, b);
+        }
+        any = true;
+      } else if (std::sscanf(part.c_str(), "%u", &a) == 1) {
+        if (!any && g_gpuOwnerSkipA == UINT32_MAX) {
+          g_gpuOwnerSkipA = a;
+          g_gpuOwnerSkipB = a;
+        } else {
+          g_gpuOwnerSkipRanges.emplace_back(a, a);
+        }
+        any = true;
+      }
+      if (comma == std::string::npos) break;
+      at = comma + 1;
+    }
+    return any;
+  };
+  auto tryParseSizes = [&](const char* s) {
+    if (!s || !*s) return false;
+    size_t at = 0;
+    const std::string list(s);
+    while (at < list.size()) {
+      const size_t comma = list.find(',', at);
+      const auto part = list.substr(at, comma == std::string::npos ? list.size() - at : comma - at);
+      unsigned v = 0;
+      if (std::sscanf(part.c_str(), "%u", &v) == 1) g_gpuOwnerSkipSizes.push_back(v);
+      if (comma == std::string::npos) break;
+      at = comma + 1;
+    }
+    return !g_gpuOwnerSkipSizes.empty();
+  };
+  auto tryParseSigs = [&](const char* s) {
+    if (!s || !*s) return false;
+    size_t at = 0;
+    const std::string list(s);
+    while (at < list.size()) {
+      const size_t comma = list.find(',', at);
+      const auto part = list.substr(at, comma == std::string::npos ? list.size() - at : comma - at);
+      unsigned prim = 0, n = 0, sz = 0;
+      if (std::sscanf(part.c_str(), "%u:%u:%u", &prim, &n, &sz) == 3) {
+        g_gpuOwnerSkipTriples.push_back({prim, n, sz});
+      } else if (std::sscanf(part.c_str(), "%u:%u", &prim, &n) == 2) {
+        g_gpuOwnerSkipSigs.emplace_back(prim, n);
+      }
+      if (comma == std::string::npos) break;
+      at = comma + 1;
+    }
+    return !g_gpuOwnerSkipSigs.empty() || !g_gpuOwnerSkipTriples.empty();
+  };
+  const char* evPath = std::getenv("NO100F_SKIP_GPU_EVENTS_FILE");
+  if (!evPath || !*evPath) evPath = "curtain-skip-events.txt";
+  char buf[256] = {};
+  if (read_skip_control_line(evPath, buf, sizeof(buf))) {
+    tryParseEvents(buf);
+  } else if (const char* e = std::getenv("NO100F_SKIP_GPU_EVENTS")) {
+    tryParseEvents(e);
+  }
+  const char* szPath = std::getenv("NO100F_SKIP_POS_SIZES_FILE");
+  if (!szPath || !*szPath) szPath = "curtain-skip-sizes.txt";
+  buf[0] = 0;
+  if (read_skip_control_line(szPath, buf, sizeof(buf))) {
+    tryParseSizes(buf);
+  } else if (const char* e = std::getenv("NO100F_SKIP_POS_SIZES")) {
+    tryParseSizes(e);
+  }
+  const char* sigPath = std::getenv("NO100F_SKIP_DRAW_SIG_FILE");
+  if (!sigPath || !*sigPath) sigPath = "curtain-skip-sig.txt";
+  buf[0] = 0;
+  if (read_skip_control_line(sigPath, buf, sizeof(buf))) {
+    tryParseSigs(buf);
+  } else if (const char* e = std::getenv("NO100F_SKIP_DRAW_SIG")) {
+    tryParseSigs(e);
+  }
+  {
+    static int once = 0;
+    if (once < 3 && (!g_gpuOwnerSkipTriples.empty() || !g_gpuOwnerSkipSigs.empty() || g_gpuOwnerSkipA != UINT32_MAX ||
+                     !g_gpuOwnerSkipRanges.empty())) {
+      ++once;
+      std::fprintf(stderr, "[curtain.skipparse] events=%u-%u extraRanges=%zu sizes=%zu sigs=%zu triples=%zu\n",
+                   g_gpuOwnerSkipA, g_gpuOwnerSkipB, g_gpuOwnerSkipRanges.size(), g_gpuOwnerSkipSizes.size(),
+                   g_gpuOwnerSkipSigs.size(), g_gpuOwnerSkipTriples.size());
+      for (const auto& t : g_gpuOwnerSkipTriples)
+        std::fprintf(stderr, "[curtain.skipparse] triple prim=%u n=%u size=%u\n", t.prim, t.n, t.size);
+    }
+  }
+}
+
+void set_gpu_owner_draw_meta(const GpuOwnerDrawMeta& meta) {
+  g_pendingOwnerMeta = meta;
+  g_hasPendingOwnerMeta = true;
+}
+void clear_gpu_owner_draw_meta() { g_hasPendingOwnerMeta = false; }
+uint32_t gpu_owner_peek_next_event() noexcept { return g_gpuOwnerEventInFrame; }
+bool gpu_owner_last_push_was_skip() noexcept { return g_lastPushWasSkip; }
+bool gpu_owner_should_skip_next_draw() {
+  parse_gpu_owner_skip();
+  const uint32_t id = g_gpuOwnerEventInFrame;
+  if (g_gpuOwnerSkipA != UINT32_MAX && id >= g_gpuOwnerSkipA && id <= g_gpuOwnerSkipB) return true;
+  for (const auto& r : g_gpuOwnerSkipRanges) {
+    if (id >= r.first && id <= r.second) return true;
+  }
+  // Match owner-dump posSize at push time.
+  if (!g_gpuOwnerSkipSizes.empty() && g_hasPendingOwnerMeta) {
+    const uint32_t sz = g_pendingOwnerMeta.posSize;
+    for (uint32_t want : g_gpuOwnerSkipSizes) {
+      if (want == sz) return true;
+    }
+  }
+  // Match primitive:fifoVertexCount (stable when POS array size wobbles).
+  if (!g_gpuOwnerSkipSigs.empty() && g_hasPendingOwnerMeta) {
+    for (const auto& sig : g_gpuOwnerSkipSigs) {
+      if (sig.first == g_pendingOwnerMeta.primitive && sig.second == g_pendingOwnerMeta.fifoVertexCount)
+        return true;
+    }
+  }
+  // Match prim:n:size (n==0 = any n, size==0 = any size). Stable vs event-ordinal drift.
+  if (!g_gpuOwnerSkipTriples.empty() && g_hasPendingOwnerMeta) {
+    for (const auto& t : g_gpuOwnerSkipTriples) {
+      if (t.prim != g_pendingOwnerMeta.primitive) continue;
+      if (t.size != 0 && t.size != g_pendingOwnerMeta.posSize) continue;
+      if (t.n != 0 && t.n != g_pendingOwnerMeta.fifoVertexCount) continue;
+      return true;
+    }
+  }
+  return false;
+}
