+static void gpu_owner_on_draw(const char* fallbackKind, uint32_t vtxCount, uint32_t indexCount) {
+  parse_gpu_owner_skip();
+  const uint32_t event = g_gpuOwnerEventInFrame++;
+  FILE* f = gpu_owner_file();
+  if (!f) return;
+  // Optional: only log a specific frame, or only after a min frame (post-landing).
+  static const int onlyFrame = [] {
+    const char* e = std::getenv("NO100F_GPU_OWNER_FRAME");
+    return e ? std::atoi(e) : -1;
+  }();
+  static const int minFrame = [] {
+    const char* e = std::getenv("NO100F_GPU_OWNER_MIN_FRAME");
+    return e ? std::atoi(e) : -1;
+  }();
+  if (onlyFrame >= 0 && (int)g_frameIndex != onlyFrame) return;
+  if (minFrame >= 0 && (int)g_frameIndex < minFrame) return;
+  static const int maxLines = [] {
+    const char* e = std::getenv("NO100F_GPU_OWNER_MAX");
+    return e ? std::atoi(e) : 4000;
+  }();
+  static int lines = 0;
+  if (lines >= maxLines) return;
+  ++lines;
+  const char* kind = g_hasPendingOwnerMeta ? g_pendingOwnerMeta.kind : fallbackKind;
+  const uint32_t pass = g_currentRenderPass == UINT32_MAX ? 0u : g_currentRenderPass;
+  if (g_hasPendingOwnerMeta) {
+    const auto& m = g_pendingOwnerMeta;
+    std::fprintf(f,
+                 "{\"type\":\"gpu_draw\",\"frame\":%u,\"pass\":%u,\"event\":%u,\"target\":\"pass-%u\",\"kind\":\"%s\","
+                 "\"fifoCmd\":\"0x%x\",\"vat\":%u,\"primitive\":%u,\"fifoVertexCount\":%u,\"expandedTriangleCount\":%u,"
+                 "\"vertexArrayGuestBase\":\"0x%llx\",\"posSize\":%u,\"posStride\":%u,\"shaderUniformMatrixSlot\":%u,"
+                 "\"numTexGens\":%u,\"cull\":%d,\"blend\":%d,\"indexCount\":%u",
+                 g_frameIndex, pass, event, pass, kind, m.fifoCmd, m.vat, m.primitive, m.fifoVertexCount,
+                 m.expandedTriangleCount, (unsigned long long)m.vertexArrayGuestBase, m.posSize, m.posStride,
+                 m.shaderUniformMatrixSlot, m.numTexGens, m.cull, m.blend, indexCount);
+    if (m.hasMtx) {
+      std::fprintf(f, ",\"mtx\":[%.6g,%.6g,%.6g,%.6g,%.6g,%.6g,%.6g,%.6g,%.6g,%.6g,%.6g,%.6g]", m.mtx[0], m.mtx[1],
+                   m.mtx[2], m.mtx[3], m.mtx[4], m.mtx[5], m.mtx[6], m.mtx[7], m.mtx[8], m.mtx[9], m.mtx[10],
+                   m.mtx[11]);
+    }
+    if (m.hasUsed) {
+      std::fprintf(f,
+                   ",\"minIdx\":%u,\"maxIdx\":%u,\"uniq\":%u,\"deepUsed\":%u,"
+                   "\"usedMin\":[%.6g,%.6g,%.6g],\"usedMax\":[%.6g,%.6g,%.6g]",
+                   m.minIdx, m.maxIdx, m.uniq, m.deepUsed, m.usedMin[0], m.usedMin[1], m.usedMin[2], m.usedMax[0],
+                   m.usedMax[1], m.usedMax[2]);
+    }
+    if (m.hasWorld) {
+      std::fprintf(f,
+                   ",\"worldMin\":[%.6g,%.6g,%.6g],\"worldMax\":[%.6g,%.6g,%.6g],"
+                   "\"worldYspan\":%.6g,\"worldZspan\":%.6g",
+                   m.worldMin[0], m.worldMin[1], m.worldMin[2], m.worldMax[0], m.worldMax[1], m.worldMax[2],
+                   m.worldMax[1] - m.worldMin[1], m.worldMax[2] - m.worldMin[2]);
+    }
+    std::fprintf(f, "}\n");
+  } else {
+    std::fprintf(f,
+                 "{\"type\":\"gpu_draw\",\"frame\":%u,\"pass\":%u,\"event\":%u,\"target\":\"pass-%u\",\"kind\":\"%s\","
+                 "\"fifoVertexCount\":%u,\"indexCount\":%u}\n",
+                 g_frameIndex, pass, event, pass, kind, vtxCount, indexCount);
+  }
+  if ((lines & 63) == 0) std::fflush(f);
+  g_hasPendingOwnerMeta = false;
+}
+
 static void push_draw_command(ShaderDrawCommand data) {
+  g_lastPushWasSkip = false;
+  if (!g_gpuOwnerSkipSizes.empty() && g_hasPendingOwnerMeta &&
+      (g_pendingOwnerMeta.primitive == 144 || g_pendingOwnerMeta.posSize == 12648 ||
+       g_pendingOwnerMeta.posSize == 6540)) {
+    if (static int n = 0; n++ < 80)
+      std::fprintf(stderr, "[curtain.pushmeta] size=%u n=%u prim=%u ntg=%u blend=%d\n",
+                   g_pendingOwnerMeta.posSize, g_pendingOwnerMeta.fifoVertexCount,
+                   g_pendingOwnerMeta.primitive, g_pendingOwnerMeta.numTexGens, g_pendingOwnerMeta.blend);
+  }
+  if (gpu_owner_should_skip_next_draw()) {
+    // Still consume the event id and log a skip marker so bisect ranges stay aligned.
+    const uint32_t event = g_gpuOwnerEventInFrame++;
+    if (FILE* f = gpu_owner_file()) {
+      std::fprintf(f,
+                   "{\"type\":\"gpu_skip\",\"frame\":%u,\"pass\":%u,\"event\":%u,\"posSize\":%u,\"primitive\":%u,"
+                   "\"fifoVertexCount\":%u}\n",
+                   g_frameIndex, g_currentRenderPass == UINT32_MAX ? 0u : g_currentRenderPass, event,
+                   g_hasPendingOwnerMeta ? g_pendingOwnerMeta.posSize : 0u,
+                   g_hasPendingOwnerMeta ? g_pendingOwnerMeta.primitive : 0u,
+                   g_hasPendingOwnerMeta ? g_pendingOwnerMeta.fifoVertexCount : 0u);
+    }
+    if (static int n = 0; n++ < 80) {
+      std::fprintf(stderr, "[curtain.skippush] ev=%u size=%u n=%u prim=%u hasMeta=%d\n", event,
+                   g_hasPendingOwnerMeta ? g_pendingOwnerMeta.posSize : 0u,
+                   g_hasPendingOwnerMeta ? g_pendingOwnerMeta.fifoVertexCount : 0u,
+                   g_hasPendingOwnerMeta ? g_pendingOwnerMeta.primitive : 0u, (int)g_hasPendingOwnerMeta);
+    }
+    g_hasPendingOwnerMeta = false;
+    g_lastPushWasSkip = true;
+    gx::g_gxState.stateDirty = true;
+    return;
+  }
+  const uint32_t vtxCount = data.type == ShaderType::GX ? data.gx.vtxCount : 0u;
+  const uint32_t indexCount = data.type == ShaderType::GX ? data.gx.indexCount : 0u;
+  const char* kind = data.type == ShaderType::Clear ? "clear" : "gx";
+  gpu_owner_on_draw(kind, vtxCount, indexCount);
   push_command(CommandType::Draw, Command::Data{.draw = data});
   ++g_drawCallCount;
 }
