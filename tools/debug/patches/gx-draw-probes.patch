+// STATECHECK PROBE (env NO100F_STATECHECK): what the game's own __GXData says the GPU holds vs Aurora's decoded
+// state, at every draw. Native overrides feed Aurora's API shadow instead of the game's __GXData, so a register
+// both sides own can end up with the wrong one's value.
+static void no100f_state_check(GXPrimitive prim, GXVtxFmt vfmt, u32 vtxCount, bool raw) {
+  static const bool on = std::getenv("NO100F_STATECHECK") != nullptr;
+  if (!on || g_no100fGuestGxRead == nullptr) return;
+  auto rd = [](u32 off) { unsigned v = 0; return g_no100fGuestGxRead(off, &v) ? u32(v) : 0u; };
+  static absl::flat_hash_map<std::string, u64> counts;
+  static absl::flat_hash_set<std::string> shown;
+  static u64 nDraws = 0, nBad = 0;
+  static auto lastSummary = std::chrono::steady_clock::now();
+  ++nDraws;
+  const u32 dirty = rd(0x4F4);
+  std::string kinds, detail;
+  auto add = [&](const char* kind, const std::string& d) {
+    if (kinds.find(kind) == std::string::npos) kinds += std::string(kinds.empty() ? "" : ",") + kind;
+    detail += " " + d;
+  };
+  if (!(dirty & 4)) {
+    const u32 gm = rd(0x204);
+    const u32 gTex = gm & 0xF, gChans = (gm >> 4) & 7, gTev = ((gm >> 10) & 0xF) + 1, gHwCull = (gm >> 14) & 3, gInd = (gm >> 16) & 7;
+    const GXCullMode gCull = gHwCull == 1 ? GX_CULL_BACK : gHwCull == 2 ? GX_CULL_FRONT : static_cast<GXCullMode>(gHwCull);
+    if (gTex != g_gxState.numTexGens) add("genmode", fmt::format("texgens g{}/a{}", gTex, g_gxState.numTexGens));
+    if (gChans != g_gxState.numChans) add("genmode", fmt::format("chans g{}/a{}", gChans, g_gxState.numChans));
+    if (gTev != g_gxState.numTevStages) add("genmode", fmt::format("tev g{}/a{}", gTev, g_gxState.numTevStages));
+    if (gCull != g_gxState.cullMode) add("genmode", fmt::format("cull g{}/a{}", int(gCull), int(g_gxState.cullMode)));
+    if (gInd != g_gxState.numIndStages) add("genmode", fmt::format("ind g{}/a{}", gInd, g_gxState.numIndStages));
+  }
+  if (!raw && g_replayingDisplayList && g_no100fCurList != 0 && !(dirty & 8)) {
+    const u32 lo = rd(0x14), hi = rd(0x18);
+    const auto& vd = g_gxState.vtxDesc;
+    bool bad = false;
+    for (int a = GX_VA_PNMTXIDX; a <= GX_VA_TEX7MTXIDX; ++a) bad |= vd[a] != (((lo >> a) & 1) ? GX_DIRECT : GX_NONE);
+    bad |= vd[GX_VA_POS] != GXAttrType((lo >> 9) & 3) || vd[GX_VA_NRM] != GXAttrType((lo >> 11) & 3) ||
+           vd[GX_VA_CLR0] != GXAttrType((lo >> 13) & 3) || vd[GX_VA_CLR1] != GXAttrType((lo >> 15) & 3);
+    for (int t = 0; t < 8; ++t) bad |= vd[GX_VA_TEX0 + t] != GXAttrType((hi >> (t * 2)) & 3);
+    if (bad) add("vcd", fmt::format("vcd g{:05X}/{:04X}", lo & 0x1FFFF, hi & 0xFFFF));
+  }
+  for (u32 i = 0; i < g_gxState.numTevStages && i < 16; ++i) {
+    const u32 c = rd(0x130 + 4 * i) & 0xFFFFFF, a = rd(0x170 + 4 * i) & 0xFFFFFF;
+    if (c != (g_gxState.bpRegCache[0xC0 + 2 * i] & 0xFFFFFF)) add("tevc", fmt::format("tevc{} g{:06X}/a{:06X}", i, c, g_gxState.bpRegCache[0xC0 + 2 * i] & 0xFFFFFF));
+    if (a != (g_gxState.bpRegCache[0xC1 + 2 * i] & 0xFFFFFF)) add("teva", fmt::format("teva{} g{:06X}/a{:06X}", i, a, g_gxState.bpRegCache[0xC1 + 2 * i] & 0xFFFFFF));
+    if ((i & 1) == 0) {
+      const u32 t = rd(0x100 + 2 * i) & 0xFFFFFF, k = rd(0x1B0 + 2 * i) & 0xFFFFFF;
+      if (t != (g_gxState.bpRegCache[0x28 + i / 2] & 0xFFFFFF)) add("tref", fmt::format("tref{} g{:06X}/a{:06X}", i / 2, t, g_gxState.bpRegCache[0x28 + i / 2] & 0xFFFFFF));
+      if (k != (g_gxState.bpRegCache[0xF6 + i / 2] & 0xFFFFFF)) add("ksel", fmt::format("ksel{} g{:06X}/a{:06X}", i / 2, k, g_gxState.bpRegCache[0xF6 + i / 2] & 0xFFFFFF));
+    }
+    const auto& st = g_gxState.tevStages[i];
+    const u32 map = static_cast<u32>(st.texMapId), coord = static_cast<u32>(st.texCoordId);
+    if (map < 8 && coord < 8 && !((rd(0x4DC) >> coord) & 1)) {
+      const auto& tex = g_gxState.loadedTextures[map];
+      const auto& sc = g_gxState.texCoordScales[coord];
+      if (tex.width() != 0 && (sc.scaleS + 1u != tex.width() || sc.scaleT + 1u != tex.height() ||
+                               sc.biasS != (tex.wrap_s() == GX_REPEAT) || sc.biasT != (tex.wrap_t() == GX_REPEAT)))
+        add("su", fmt::format("su st{} c{} m{} tex {}x{} b{}{} su {}x{} b{}{}", i, coord, map, tex.width(), tex.height(),
+                              int(tex.wrap_s() == GX_REPEAT), int(tex.wrap_t() == GX_REPEAT), sc.scaleS + 1u, sc.scaleT + 1u,
+                              int(sc.biasS), int(sc.biasT)));
+    }
+  }
+  if (!kinds.empty()) {
+    ++nBad;
+    ++counts[fmt::format("{} list {:08X}{}", kinds, g_no100fCurList, raw ? " raw" : "")];
+    const std::string key = fmt::format("{:08X}{}", g_no100fCurList, detail);
+    if (shown.size() < 400 && shown.insert(key).second)
+      Log.warn("[statecheck] list {:08X}{} prim {:#x} fmt {} n {} dirty {:X} |{}", g_no100fCurList, raw ? " raw" : "",
+               int(prim), int(vfmt), vtxCount, dirty, detail);
+  }
+  const auto now = std::chrono::steady_clock::now();
+  if (now - lastSummary > std::chrono::seconds(5)) {
+    lastSummary = now;
+    std::vector<std::pair<u64, std::string>> top;
+    for (const auto& [k, n] : counts) top.emplace_back(n, k);
+    std::sort(top.rbegin(), top.rend());
