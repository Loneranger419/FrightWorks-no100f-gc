# cmake -DOUT=<file.cpp> -DFONTS=<a.ttf|b.ttf> -P embed_fonts.cmake
# Writes each font as `extern const unsigned char kFont_<Name>[]` + `kFont_<Name>Size` (name = file name without the
# extension, non-alphanumerics dropped), for ImGui's AddFontFromMemoryTTF (overlay_theme.cpp).
string(REPLACE "|" ";" FONTS "${FONTS}")
set(body "// Generated by runtime/cmake/embed_fonts.cmake from runtime/assets/fonts. Do not edit.\n#include <cstddef>\n\n")
foreach(font IN LISTS FONTS)
    get_filename_component(name "${font}" NAME_WE)
    string(REGEX REPLACE "[^A-Za-z0-9]" "" name "${name}")
    file(READ "${font}" hex HEX)
    string(LENGTH "${hex}" length)
    math(EXPR size "${length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    string(APPEND body "extern const unsigned char kFont_${name}[] = {\n${hex}\n};\n")
    string(APPEND body "extern const std::size_t kFont_${name}Size = ${size};\n\n")
endforeach()
file(WRITE "${OUT}.tmp" "${body}")
configure_file("${OUT}.tmp" "${OUT}" COPYONLY)
file(REMOVE "${OUT}.tmp")
