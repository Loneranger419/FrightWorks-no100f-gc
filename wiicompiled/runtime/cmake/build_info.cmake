# cmake -DREPO=<repo root> -DOUT=<file.cpp> -P build_info.cmake
# Runs on every build and rewrites OUT only when something changed, so test builds always say what they were built
# from: the FrightWorks version (launcher csproj <Version>, the one place it is set), the git branch, the commit and,
# for uncommitted changes, a short hash of `git diff HEAD` (two builds with different edits get different IDs).
# A build of a clean checkout at the tag v<version> is a release: its ID is just the version.
set(version "0.0.0")
file(READ "${REPO}/launcher/ScoobyReMasked.Launcher.csproj" csproj)
if(csproj MATCHES "<Version>([^<]+)</Version>")
    set(version "${CMAKE_MATCH_1}")
endif()

set(branch "")
set(commit "")
set(changes "")
set(tagged FALSE)
if(NOT GIT_EXECUTABLE OR NOT EXISTS "${GIT_EXECUTABLE}")
    find_package(Git QUIET)
endif()
if(GIT_EXECUTABLE AND EXISTS "${GIT_EXECUTABLE}")
    macro(git out)
        execute_process(COMMAND "${GIT_EXECUTABLE}" ${ARGN} WORKING_DIRECTORY "${REPO}"
                        OUTPUT_VARIABLE ${out} OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE git_result)
        if(NOT git_result EQUAL 0)
            set(${out} "")
        endif()
    endmacro()
    git(branch rev-parse --abbrev-ref HEAD)
    if(branch STREQUAL "HEAD")
        set(branch "detached")
    endif()
    git(commit rev-parse --short=7 HEAD)
    git(status status --porcelain --untracked-files=no)
    if(NOT status STREQUAL "")
        git(diff diff HEAD)
        string(SHA1 diff_hash "${diff}")
        string(SUBSTRING "${diff_hash}" 0 4 changes)
    endif()
    git(tags tag --points-at HEAD)
    if(tags MATCHES "(^|\n)v${version}(\n|$)" AND changes STREQUAL "")
        set(tagged TRUE)
    endif()
endif()

if(tagged)
    set(id "${version}")
elseif(commit STREQUAL "")
    set(id "${version} (unknown build: no git)")
else()
    set(id "${version} ${branch}@${commit}")
    if(NOT changes STREQUAL "")
        string(APPEND id "+${changes}")
    endif()
endif()
if(tagged)
    set(release "true")
else()
    set(release "false")
endif()

file(WRITE "${OUT}.tmp" "// Generated by runtime/cmake/build_info.cmake on every build. Do not edit.
#include \"build_info.h\"

namespace BuildInfo {
const char* Version() noexcept { return \"${version}\"; }
const char* Branch() noexcept { return \"${branch}\"; }
const char* Commit() noexcept { return \"${commit}\"; }
const char* Changes() noexcept { return \"${changes}\"; }
bool Release() noexcept { return ${release}; }
const char* Id() noexcept { return \"${id}\"; }
} // namespace BuildInfo
")
configure_file("${OUT}.tmp" "${OUT}" COPYONLY)
file(REMOVE "${OUT}.tmp")
